{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "${albumArt}",
              "size": "medium",
              "style": "person",
              "altText": "Album artwork"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "size": "medium",
              "wrap": true,
              "maxLines": 1
            },
            {
              "type": "TextBlock",
              "text": "${artist}",
              "isSubtle": true,
              "spacing": "none",
              "wrap": true,
              "maxLines": 1
            },
            {
              "type": "TextBlock",
              "text": "${status}",
              "isSubtle": true,
              "spacing": "small",
              "size": "small"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open MyBeats",
      "url": "https://clockblocked.github.io/music.me/?page=player"
    }
  ]
}