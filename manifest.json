{
  "name": "MyBeats Music",
  "short_name": "MyBeats",
  "description": "Stream & share the music you love by your favourite Artists.",
  "id": "10221983",
  "start_url": "https://clockblocked.github.io/music.me/",
  "scope": "/music.me/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#22272e",
  "theme_color": "#22272e",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment"],

