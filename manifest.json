{
  "name": "MyBeats Music",
  "short_name": "MyBeats",
  "description": "Stream & Share",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#12141c",
  "theme_color": "#12141c",
  "orientation": "portrait-primary",
  "scope": "/",
  "id": "/",
  "categories": ["music", "entertainment"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/manifest/android/72.png", "sizes": "72x72", "type": "image/png", "purpose": "any maskable" },
    { "src": "/manifest/android/96.png", "sizes": "96x96", "type": "image/png", "purpose": "any maskable" },
    { "src": "/manifest/android/128.png", "sizes": "128x128", "type": "image/png", "purpose": "any maskable" },
    { "src": "/manifest/android/144.png", "sizes": "144x144", "type": "image/png", "purpose": "any maskable" },
    { "src": "/manifest/android/152.png", "sizes": "152x152", "type": "image/png", "purpose": "any maskable" },
    { "src": "/manifest/android/192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/manifest/android/384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "/manifest/android/512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "screenshots": [
    { "src": "/manifest/screenshots/home.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide" },
    { "src": "/manifest/screenshots/mobile.png", "sizes": "750x1334", "type": "image/png", "form_factor": "narrow" }
  ],
  "shortcuts": [
    {
      "name": "Now Playing",
      "short_name": "Playing",
      "description": "Resume current playback",
      "url": "/?page=player",
      "icons": [{ "src": "/manifest/icons/playing-96.png", "sizes": "96x96", "type": "image/png" }, { "src": "/manifest/icons/playing-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Browse your music library",
      "url": "/?page=library",
      "icons": [{ "src": "/manifest/icons/library-96.png", "sizes": "96x96", "type": "image/png" }, { "src": "/manifest/icons/library-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "description": "Your favorite songs",
      "url": "/?page=favorites",
      "icons": [{ "src": "/manifest/icons/favorites-96.png", "sizes": "96x96", "type": "image/png" }, { "src": "/manifest/icons/favorites-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Playlists",
      "short_name": "Playlists",
      "description": "Your playlists",
      "url": "/?page=playlists",
      "icons": [{ "src": "/manifest/icons/playlists-96.png", "sizes": "96x96", "type": "image/png" }, { "src": "/manifest/icons/playlists-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search artists, albums and songs",
      "url": "/?page=search",
      "icons": [{ "src": "/manifest/icons/search-96.png", "sizes": "96x96", "type": "image/png" }, { "src": "/manifest/icons/search-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "widgets": [
    {
      "name": "Now Playing",
      "short_name": "Now Playing",
      "description": "Shows and controls the currently playing track",
      "tag": "mybeats-now-playing",
      "template": "now-playing",
      "ms_ac_template": "/widgets/now-playing.json",
      "data": "/widgets/now-playing-data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [{ "src": "/manifest/android/192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link"
    }
  },
  "protocol_handlers": [
    { "protocol": "web+mybeats", "url": "/?q=%s" }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "edge_side_panel": { "preferred_width": 400 },
  "related_applications": [],
  "prefer_related_applications": false
}
