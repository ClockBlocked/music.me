    },
    {
      "src": "https://clockblocked.github.io/music.me/manifest/screenshots/desktop-01.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop Player"
    }
  ],

  "shortcuts": [
    {
      "name": "Now Playing",
      "short_name": "Playing",
      "description": "Resume current playback",
      "url": "https://clockblocked.github.io/music.me/?page=player",
      "icons": [
        {
          "src": "https://clockblocked.github.io/music.me/manifest/icons/playing-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Browse your music library",
      "url": "https://clockblocked.github.io/music.me/?page=library"
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "description": "Your favorite songs",
      "url": "https://clockblocked.github.io/music.me/?page=favorites"
    },
    {
      "name": "Playlists",
      "short_name": "Playlists",
      "description": "Your playlists",
      "url": "https://clockblocked.github.io/music.me/?page=playlists"
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search artists, albums and songs",
      "url": "https://clockblocked.github.io/music.me/?page=search"
    }
  ],

  "file_handlers": [
    {
      "action": "https://clockblocked.github.io/music.me/handle-audio-file",
      "accept": {
        "audio/wav": [".wav"],
        "audio/x-wav": [".wav"],
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a", ".mp4"],
        "audio/aac": [".aac", ".adts"],
        "audio/ogg": [".ogg", ".oga"],
        "application/ogg": [".ogg"],
        "audio/webm": [".webm"],
        "audio/flac": [".flac"],
        "audio/x-flac": [".flac"]
      }
    }
  ],

  "share_target": {
    "action": "https://clockblocked.github.io/music.me/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link"
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+mybeats",
      "url": "https://clockblocked.github.io/music.me/?q=%s"
    }
  ],

  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },

  "handle_links": "preferred",
  "prefer_related_applications": false,

  "widgets": [
    {
      "name": "Now Playing",
      "short_name": "Now Playing",
      "description": "Shows and controls the currently playing track",
      "tag": "mybeats-now-playing",
      "template": "now-playing",
      "ms_ac_template": "https://clockblocked.github.io/music.me/app/widgets/now-playing.json",
      "data": "https://clockblocked.github.io/music.me/app/widgets/now-playing-data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [
        {
          "src": "https://clockblocked.github.io/music.me/manifest/android/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "edge_side_panel": {
    "preferred_width": 400
  }
}
